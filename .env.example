# PostgreSQL connections. Sertify always uses the isolated `sertify` schema.
DATABASE_URL=
DIRECT_URL=

# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Must decode to exactly 32 bytes (base64 or 64 hexadecimal characters).
APP_CREDENTIAL_ENCRYPTION_KEY=

# Protects internal Vercel-triggered worker routes. Use a long random value.
CRON_SECRET=

# Protects GET /api/internal/health. Use a different long random value from CRON_SECRET.
HEALTH_CHECK_SECRET=

# Best-effort per-instance API spam protection. Durable provider limits remain authoritative.
EVENT_CREATION_RATE_LIMIT=5
EVENT_CREATION_RATE_WINDOW_MS=60000
SEND_INITIATION_RATE_LIMIT=20
SEND_INITIATION_RATE_WINDOW_MS=60000
ORGANIZATION_INVITE_RATE_LIMIT=10
ORGANIZATION_INVITE_RATE_WINDOW_MS=3600000

# Server-only certificate template storage and rendering credentials.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional site-wide SMTP route. Organization SMTP is preferred when usable.
SITE_SMTP_HOST=
SITE_SMTP_PORT=465
SITE_SMTP_USERNAME=
SITE_SMTP_PASSWORD=
SITE_SMTP_FROM_EMAIL=
SITE_SMTP_FROM_NAME=NameFrame
SITE_SMTP_SECURE=true
SITE_SMTP_RATE_LIMIT_PER_MINUTE=30
SITE_SMTP_SEND_LIMIT=1000000

# Legacy NameFrame Gmail compatibility fallback. Prefer SITE_SMTP_* in production.
EMAIL_USER=
EMAIL_PASSWORD=

# Backup email provider.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_FROM_NAME=NameFrame
RESEND_RATE_LIMIT_PER_MINUTE=60
RESEND_SEND_LIMIT=1000000
